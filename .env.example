# Template for .env — copy to .env and fill in. .env is gitignored; never
# commit real keys. Docker Compose reads .env automatically for ${VAR}
# substitution. Shell-exported variables take precedence over .env.

# Required for the proxy (not for the guardrail service alone).
# Real provider key, or "na" as a placeholder when UPSTREAM_API_BASE points
# at a local model server (Ollama, vLLM, LiteLLM, ...) that needs no auth.
UPSTREAM_API_KEY=sk-your-key-here

# Optional overrides (defaults shown):

# OpenAI-compatible endpoint the proxy forwards to (default: https://api.openai.com/v1)
#UPSTREAM_API_BASE=https://api.openai.com/v1

# Default model when the request omits "model" (default: gpt-4o)
#UPSTREAM_MODEL=gpt-4o

# Block all traffic if the guardrail service is unreachable (default: true)
#FAIL_CLOSED=true

# Guardrail service timeout per check, seconds (default: 3)
#GUARDRAILS_TIMEOUT_SECONDS=3

# Upstream LLM call timeout, seconds (default: 120)
#UPSTREAM_TIMEOUT_SECONDS=120

# Comma-separated exact-match tokens to detect in prompts and outputs
# (e.g. seeded canary credentials) (default: empty)
#CANARY_TOKENS=

# Needle 3 local triage classifier in the guardrail service (audit-only,
# action "allow" — logged, never enforced). Requires the engine + weights
# baked into the image at build time; failures self-disable the scanner.
#NEEDLE_ENABLED=false  # zero-shot precision FAILED evaluation (D-13); off by default

# Host port the proxy publishes on (default 8000). Override if another
# local service already binds 8000 (e.g. another project's dev server).
#PROXY_HOST_PORT=8100
